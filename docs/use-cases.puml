@startuml Fieldbook_MVP_Use_Cases
left to right direction
actor Visitor
actor "Account holder" as Holder
actor "Farm owner" as Owner
actor Administrator as Admin
actor "Assigned worker" as Worker
actor "Open-Meteo API" as WeatherAPI
Owner --|> Holder
Admin --|> Holder
Worker --|> Holder
rectangle "Fieldbook — first-month MVP" {
  usecase "Sign in" as Login
  usecase "Sign out" as Logout
  usecase "View permitted farms and fields" as ReadFarm
  usecase "View planting seasons" as ReadCrops
  usecase "View and search activity history" as History
  usecase "View dashboard" as Dashboard
  usecase "View farm weather" as Weather
  usecase "Configure personal weather connection" as WeatherConfig
  usecase "Fetch weather conditions" as Fetch
  usecase "Manage farms and fields" as ManageFarm
  usecase "Manage farm access (owner)" as Share
  usecase "Manage planting cycles and stages" as ManageCrops
  usecase "Record and edit fieldwork / observations / harvest" as Work
  usecase "Manage accounts, roles and crop reference data" as Administration
  usecase "Inspect audit records" as Audit
}
Visitor -- Login
Holder -- Logout
Holder -- ReadFarm
Holder -- ReadCrops
Holder -- History
Holder -- Dashboard
Holder -- Weather
Holder -- WeatherConfig
Owner -- ManageFarm
Owner -- Share
Owner -- ManageCrops
Owner -- Work
Worker -- Work
Admin -- ManageFarm
Admin -- Share
Admin -- ManageCrops
Admin -- Work
Admin -- Administration
Admin -- Audit
Fetch ..> Weather : <<extend>>\n[connected and refresh needed]
WeatherAPI -- Fetch
note bottom of ManageFarm
  Changes require the appropriate farm membership.
  A worker records fieldwork on assigned fields.
end note
@enduml
